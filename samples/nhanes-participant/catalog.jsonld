  "http://purl.org/dc/terms/description": [
   {
    "@language": "en",
    "@value": "The immutable schema every NHANES Participant record is validated against: 153 variables with their definitions, datatypes, units, enumerated values and codes, and the sixteen typed reasons a value may be missing. Current version SHA-256 0df45878b0db1c1515e860a4b9993c5f086ffaaebc4c16aaae2092e1da3d3b3b."
   }
  ],
